{
  "formatVersion": "0.5",
  "meta": {
    "name": "Button",
    "version": null,
    "tokensVersion": null,
    "type": "atom",
    "figmaKey": "KEY-BUTTON",
    "library": "B2C",
    "documentationLinks": [
      "https://exemple.test/button"
    ]
  },
  "api": {
    "props": {
      "state": {
        "type": "enum",
        "enum": [
          "default",
          "hover"
        ],
        "default": "default"
      },
      "hierarchy": {
        "type": "enum",
        "enum": [
          "primary",
          "secondary"
        ],
        "default": "primary"
      },
      "showLeftIcon": {
        "type": "boolean",
        "default": true,
        "controls": [
          {
            "layer": "left-icon",
            "attribute": "visible"
          }
        ]
      },
      "_scrollable": {
        "type": "boolean",
        "default": false,
        "controls": []
      }
    }
  },
  "variants": [
    {
      "values": {
        "state": "default",
        "hierarchy": "primary"
      },
      "position": [
        64,
        64
      ]
    },
    {
      "values": {
        "state": "hover",
        "hierarchy": "primary"
      },
      "position": [
        64,
        184
      ]
    }
  ],
  "structure": {
    "slots": {
      "label": {
        "as": "children",
        "default": {
          "text": "Label"
        },
        "controls": [
          {
            "layer": "label",
            "attribute": "text"
          }
        ]
      },
      "leftIcon": {
        "accepts": "Instance",
        "default": {
          "swap": "account_balance"
        },
        "preferred": [
          "Avatar",
          "account_balance"
        ],
        "controls": [
          {
            "layer": "left-icon",
            "attribute": "component"
          }
        ]
      }
    },
    "trees": [
      {
        "when": {},
        "tree": [
          {
            "name": "left-icon",
            "type": "instance",
            "component": "account_balance"
          },
          {
            "name": "label",
            "type": "text"
          },
          {
            "name": "caption",
            "type": "text"
          },
          {
            "name": "badge",
            "type": "instance",
            "component": "Badge"
          }
        ]
      },
      {
        "when": {
          "state": "hover"
        },
        "tree": [
          {
            "name": "left-icon",
            "type": "instance",
            "component": "account_balance"
          },
          {
            "name": "label",
            "type": "text"
          },
          {
            "name": "caption",
            "type": "text"
          },
          {
            "name": "badge",
            "type": "instance",
            "component": "Badge"
          },
          {
            "name": "focus-ring",
            "type": "frame"
          }
        ]
      }
    ],
    "uses": [
      "Badge",
      "account_balance"
    ]
  },
  "styles": {
    "default": {
      "when": {
        "state": "default",
        "hierarchy": "primary"
      },
      "root": {
        "background": {
          "token": "color/blue/700"
        },
        "radius": {
          "token": "radius/medium"
        },
        "padding": {
          "top": {
            "raw": 12
          },
          "right": {
            "raw": 0
          },
          "bottom": {
            "raw": 12
          },
          "left": {
            "raw": 16
          }
        },
        "gap": {
          "token": "spacing/small"
        },
        "layout": {
          "direction": "row",
          "mainAlign": "center",
          "crossAlign": "center",
          "clip": true,
          "minWidth": {
            "raw": 144
          },
          "sizingH": "hug",
          "sizingV": "hug"
        }
      },
      "left-icon": {
        "layout": {
          "sizingH": "fixed",
          "width": {
            "raw": 24
          },
          "sizingV": "fixed",
          "height": {
            "raw": 24
          }
        }
      },
      "left-icon/vector": {
        "background": {
          "token": "color/white"
        }
      },
      "label": {
        "textColor": {
          "token": "color/white"
        },
        "textStyle": "label/1/semibold",
        "layout": {
          "sizingH": "fill",
          "textAlignVertical": "center"
        }
      },
      "caption": {
        "textColor": {
          "raw": "#333333"
        },
        "typography": {
          "fontFamily": "Source Sans Pro",
          "fontStyle": "Regular",
          "fontSize": 14,
          "lineHeight": 20
        }
      }
    },
    "overrides": [
      {
        "when": {
          "state": "hover"
        },
        "styles": {
          "root": {
            "background": {
              "token": "color/blue/800"
            },
            "layout": {
              "direction": "row",
              "mainAlign": "center",
              "crossAlign": "center",
              "clip": false,
              "minWidth": {
                "raw": 144
              },
              "sizingH": "hug",
              "sizingV": "hug"
            },
            "stroke": {
              "raw": "#CCCCCC"
            },
            "strokeWeight": {
              "raw": 1
            },
            "strokeAlign": "inside"
          },
          "modes": {
            "Semantic": "client"
          },
          "focus-ring": {
            "stroke": {
              "token": "color/blue/700"
            },
            "strokeWeight": {
              "raw": 2
            },
            "layout": {
              "absolute": true,
              "x": -2,
              "y": -2,
              "constraints": {
                "horizontal": "stretch",
                "vertical": "stretch"
              }
            }
          }
        }
      }
    ]
  },
