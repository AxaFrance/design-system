{
  "name": "@axa-fr/design-system",
  "version": "2.0.0",
  "description": "",
  "packageManager": "npm@12.2.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AxaFrance/design-system.git"
  },
  "scripts": {
    "dev": "turbo dev --filter=./apps/*",
    "dev:client": "turbo dev --filter=./apps/look-and-feel-stories",
    "dev:prospect": "turbo dev --filter=./apps/apollo-stories",
    "dev:distributeur": "turbo dev --filter=./apps/slash-stories",
    "build": "turbo build --concurrency=1 --filter=!./samples/vite",
    "build:distributeur": "turbo build --filter=./apps/slash-stories",
    "build:client": "turbo build --filter=./apps/look-and-feel-stories",
    "build:prospect": "turbo build --filter=./apps/apollo-stories",
    "lint": "turbo lint",
    "check": "vp check",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "package:check": "npx --yes package-lock-utd@1.1.3",
    "prepare": "husky",
    "test": "vp test",
    "test:ui": "vp test --ui"
  },
  "author": "AxaFrance",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AxaFrance/design-system/issues"
  },
  "homepage": "https://github.com/AxaFrance/design-system#readme",
  "workspaces": [
    "samples/vite",
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@material-symbols/svg-400": "^0.48.2",
    "@material-symbols/svg-700": "^0.48.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "commander": "^15.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "~6.0.3",
    "turbo": "^2.11.10",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "{package,package-lock}.json": "npm run package:check",
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "vp check --fix",
    "*.{css,scss,json,jsonc,md,mdx,yml,yaml,html}": "vp fmt --no-error-on-unmatched-pattern"
  },
  "volta": {
    "node": "24.22.1",
    "npm": "12.2.1"
  },
  "allowScripts": {
    "esbuild": true,
    "@swc/core": true,
    "@parcel/watcher": true,
    "unrs-resolver": true
  }
}
