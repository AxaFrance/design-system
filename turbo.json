{
    "$schema": "https://v2-11-10.turborepo.dev/schema.json",
    "cacheMaxAge": "50d",
    "cacheMaxSize": "1GB",
    "tasks": {
        "build": {
            "inputs": [
                "$TURBO_DEFAULT$",
                "!**/__tests__/**",
                "!**/*.{test,spec}.{ts,tsx}",
                "!**/*.md"
            ],
            "outputs": [
                "dist/**",
                "generated/**",
                "storybook-static/**"
            ],
            "dependsOn": [
                "^build"
            ]
        },
        "check-types": {
            "dependsOn": [
                "^build"
            ]
        },
        "dev": {
            "persistent": true,
            "cache": false
        },
        "dev:client": {
            "persistent": true,
            "cache": false
        },
        "dev:prospect": {
            "persistent": true,
            "cache": false
        },
        "dev:distributeur": {
            "persistent": true,
            "cache": false
        },
        "eslint": {
            "dependsOn": [
                "^build"
            ],
            "outputLogs": "errors-only"
        },
        "transit": {
            "dependsOn": [
                "^transit"
            ]
        },
        "prettier": {
            "dependsOn": [
                "transit"
            ],
            "outputLogs": "errors-only"
        },
        "stylelint": {
            "dependsOn": [
                "transit"
            ],
            "outputLogs": "errors-only"
        },
        "lint": {
            "dependsOn": [
                "eslint",
                "prettier",
                "check-types",
                "stylelint"
            ]
        },
        "//#test:coverage": {
            "dependsOn": [
                "@axa-fr/canopee-css#build"
            ],
            "inputs": [
                "package-lock.json",
                "vitest.config.ts",
                "vitest.workspace.ts",
                "packages/canopee-react/src/**",
                "packages/canopee-react/package.json",
                "packages/canopee-react/tsconfig.json",
                "packages/canopee-react/vitest.config.ts",
                "packages/canopee-react/vitest.setup.ts"
            ],
            "outputs": [
                "coverage/**"
            ],
            "env": [
                "CI"
            ]
        }
    }
}