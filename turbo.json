{
    "$schema": "https://v2-11-10.turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "inputs": [
                "$TURBO_DEFAULT$",
                "!**/__tests__/**",
                "!**/*.{test,spec}.{ts,tsx}",
                "!**/*.md"
            ],
            "outputs": [
                "dist/**",
                "generated/**",
                "storybook-static/**"
            ],
            "dependsOn": [
                "^build",
                "^lint"
            ]
        },
        "check-types": {
            "dependsOn": [
                "^check-types",
                "^build"
            ]
        },
        "dev": {
            "persistent": true,
            "cache": false
        },
        "dev:client": {
            "persistent": true,
            "cache": false
        },
        "dev:prospect": {
            "persistent": true,
            "cache": false
        },
        "dev:distributeur": {
            "persistent": true,
            "cache": false
        },
        "lint": {
            "dependsOn": [
                "^check-types"
            ]
        }
    }
}